# Adresse der Werkboq-PocketBase.
# Bewusst 8095 statt PocketBase-Standard 8090, damit eine andere lokal laufende
# PocketBase (z. B. FD-Book) nicht versehentlich getroffen wird.
VITE_PB_URL=http://127.0.0.1:8095

# Admin-Zugang der PocketBase, einmalig im Admin-UI angelegt
# (http://127.0.0.1:8095/_/). Wird von server/einrichten.mjs zum Anlegen der
# Collections gebraucht.
PB_ADMIN_EMAIL=admin@example.at
PB_ADMIN_PASSWORD=bitte-aendern

# Erster Anwendungsbenutzer — damit meldest du dich in Werkboq selbst an.
# Wird von einrichten.mjs angelegt, wenn noch kein Benutzer existiert.
# Mindestens 8 Zeichen. Nicht dasselbe wie der Admin-Zugang oben.
WB_BENUTZER_EMAIL=julian@example.at
WB_BENUTZER_PASSWORT=bitte-aendern
WB_BENUTZER_NAME=Julian

# Bequemer Entwicklungszugang: Benutzer "adm", Passwort "adm".
# Setzt die Passwort-Mindestlänge vorübergehend auf 3 und wirkt nur gegen eine
# PocketBase auf 127.0.0.1. Vor jeder echten Inbetriebnahme aufräumen mit
#   npm run entwicklung-weg
# Das löscht alle so gekennzeichneten Konten und setzt die Mindestlänge auf 8.
WB_ENTWICKLUNG=ja
